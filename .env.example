# Discord bot credentials and target scope
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=123456789012345678
ALLOWED_CHANNEL_ID=123456789012345678

# Local HTTP/JSON API authentication and port (always bound to 127.0.0.1)
API_TOKEN=replace_with_a_long_random_secret_token
API_PORT=8080

# Optional executable overrides when yt-dlp or ffmpeg are not on PATH
# YT_DLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
